<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>lights.ac</path>

  <animation>
    <object-name>base</object-name>
    <object-name>fond</object-name>
    
    <object-name>text</object-name>
    <object-name>on-off0</object-name>
    <object-name>landing</object-name>
    <object-name>taxi</object-name>
    <object-name>position</object-name>
    <object-name>strobe</object-name>
    <object-name>map</object-name>
    <object-name>instruments</object-name>
  
    <object-name>luminosite</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>text</object-name>
    <object-name>on-off0</object-name>
    <object-name>landing</object-name>
    <object-name>taxi</object-name>
    <object-name>position</object-name>
    <object-name>strobe</object-name>
    <object-name>map</object-name>
    <object-name>instruments</object-name>
 
    <object-name>luminosite</object-name>
    <condition>
      <property>/controls/lighting/instrument-lights</property>
      <property>/controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>/controls/lighting/luminosite-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.25 </green>
      <blue>  0.25 </blue>
    </emission>
  </animation>

 

  <!-- Lights -->
  <!-- Strobe -->
  <animation>
    <type>pick</type>
    <object-name>strobe</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>controls/switches/strobe-switch</property>
       </binding>
	    <binding>
        <command>property-toggle</command>
        <property>controls/switches/beacon-switch</property>
       </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>strobe</object-name>
    <property>controls/switches/strobe-switch</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- Landing -->
  <animation>
    <type>pick</type>
    <object-name>landing</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>controls/switches/landing-lights-switch</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>landing</object-name>
    <property>controls/switches/landing-lights-switch</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- Instruments -->
  <animation>
    <type>pick</type>
    <object-name>instruments</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>/controls/lighting/instrument-lights</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>instruments</object-name>
    <property>/controls/lighting/instrument-lights</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- taxi -->
  <animation>
    <type>pick</type>
    <object-name>taxi</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>/controls/lighting/taxi-light</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>taxi</object-name>
    <property>/controls/lighting/taxi-light</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- position -->
  <animation>
    <type>pick</type>
    <object-name>position</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>controls/switches/nav-lights-switch</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>position</object-name>
    <property>controls/switches/nav-lights-switch</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

 
   
  <!--  Throttle pick animation -->
  <animation>
    <type>pick</type>
    <object-name>luminosite</object-name>
    <visible>true</visible>
    <action>
      <button>3</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-adjust</command>
        <property>/controls/lighting/floods-lights</property>
        <step> 0.1 </step>
        <min> 0 </min>
        <max> 1 </max>
        <wrap>false</wrap>
      </binding>
    </action>
    <action>
      <button>4</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-adjust</command>
        <property>/controls/lighting/floods-lights</property>
        <step> -0.1 </step>
        <min> 0 </min>
        <max> 1 </max>
        <wrap>false</wrap>
      </binding>
    </action>
  </animation>
  
  <animation> 
    <type>rotate</type>
    <object-name>luminosite</object-name>
    <property>controls/lighting/floods-lights</property>
    <factor> 270 </factor>
    <center>
      <x-m>  0.003373 </x-m>
      <y-m> -0.004490 </y-m>
      <z-m> -0.007263 </z-m>  
    </center>  
    <axis> 
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>                                                              
 
</PropertyList>
