<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>fuel-bat.ac</path>

  <animation>
    <object-name>base</object-name>
    <object-name>fond</object-name>
    
    <object-name>text</object-name>
 
    <object-name>on-off1</object-name>
    <object-name>fuel-pump</object-name>
    <object-name>generator</object-name>
    <object-name>battery</object-name>
   
  </animation>

  <animation>
    <type>material</type>
    <object-name>text</object-name>
   
    <object-name>on-off1</object-name>
    <object-name>fuel-pump</object-name>
    <object-name>generator</object-name>
    <object-name>battery</object-name>
   
    <condition>
      <property>/controls/lighting/instrument-lights</property>
      <property>/controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>/controls/lighting/luminosite-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.25 </green>
      <blue>  0.25 </blue>
    </emission>
  </animation>

  <!-- Fuel pump -->
  <animation>
    <type>pick</type>
    <object-name>fuel-pump</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>controls/engines/engine/fuel-pump</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>fuel-pump</object-name>
    <property>/controls/engines/engine/fuel-pump</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

 

  <!-- generator -->
  <animation>
    <type>pick</type>
    <object-name>generator</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>/controls/electric/engine/generator</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>generator</object-name>
    <property>/controls/electric/engine/generator</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- battery -->
  <animation>
    <type>pick</type>
    <object-name>battery</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>/controls/electric/battery-switch</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>battery</object-name>
    <property>/controls/electric/battery-switch</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>
   
                                
 
</PropertyList>
